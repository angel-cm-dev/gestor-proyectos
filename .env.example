# Variables para docker compose. Copia este archivo como .env y cambia los valores.
# NUNCA subas el .env real al repositorio.

# --- PostgreSQL ---
POSTGRES_DB=gestor_proyectos
POSTGRES_USER=gestor
POSTGRES_PASSWORD=cambia_esta_clave

# --- API ---
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:8080
# Carga usuarios y proyectos de demostración si la BD está vacía.
SEED_DEMO=true

# --- Puertos publicados en el host ---
API_PORT=3000
WEB_PORT=8080
