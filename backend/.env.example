# Copia este archivo como backend/.env para desarrollo local sin Docker.
NODE_ENV=development
PORT=3000
# postgres = PostgreSQL real | memory = pg-mem en memoria (demo sin instalar nada)
DB_DRIVER=memory
DATABASE_URL=postgres://gestor:gestor_dev_pass@localhost:5432/gestor_proyectos
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
SEED_DEMO=true
