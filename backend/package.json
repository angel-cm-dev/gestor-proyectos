{
  "name": "gestor-proyectos-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST del Gestor de Proyectos: proyectos, tareas, kanban, timesheet y reportes.",
  "license": "MIT",
  "author": "Angel Castañeda Meza (https://github.com/angel-cm-dev)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env src/infrastructure/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/infrastructure/db/cli.ts seed"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.5",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.16.3",
    "pg-mem": "3.0.5",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "pino-pretty": "13.1.1",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.4"
  }
}
